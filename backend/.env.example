# ============ 生成模型（多模态）服务配置 ============
API_KEY=your-llm-api-key
MODEL_NAME=gpt-4o-mini
MODEL_URL=https://api.openai.com/v1

# ============ 向量嵌入服务配置 ============
# 可填写 OpenAI 兼容网关基地址、/v1 基地址，或完整 /embeddings 端点。
EMBEDDING_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-large
EMBEDDING_API_KEY=your-embedding-api-key

# ============ PDF 上传和提取服务配置 ============
UPLOAD_BASE_DIR=/root/Agent-Project-Collection/cases/1_RAG—VLM/Multimodal_RAG_Fusion/backend/output/uploads
EXTRACTION_RESULTS_DIR=/root/Agent-Project-Collection/cases/1_RAG—VLM/Multimodal_RAG_Fusion/backend/output/extraction_results
MAX_FILE_SIZE_MB=100

INFOR_EXTRAC_SERVICE_PORT=8006
INFOR_EXTRAC_SERVICE_HOST=0.0.0.0

CHUNK_SERVICE_PORT=8001
CHUNK_SERVICE_HOST=0.0.0.0
CHUNKING_SERVICE_ENABLED=true

# ============ OCR V2 Sidecar 配置 ============
MINERU_API_URL=http://localhost:10010/file_parse
MINERU_VIZ_DIR=/root/Agent-Project-Collection/cases/1_RAG—VLM/Multimodal_RAG_Fusion/backend/mineru_visualizations
MINERU_BACKEND=pipeline
MINERU_TIMEOUT=600
ENABLE_REAL_MINERU=false
MINERU_REAL_DOCKER_DIR=/root/Agent-Project-Collection/cases/3_RAG—OCR/Multimodal_RAG_OCR/minerU/MinerU_2_5_4/docker
MINERU_REAL_COMPOSE_FILE=compose.yaml
MINERU_REAL_ENABLE_API=true
MINERU_REAL_ENABLE_VLLM_SERVER=false
MINERU_REAL_ENABLE_GRADIO=false
MINERU_REAL_GRADIO_PORT=7860
MINERU_REAL_IMAGE_NAME=mineru-vllm:2.5.4
MINERU_REAL_BASE_IMAGE=docker.io/vllm/vllm-openai:v0.10.1.1
MINERU_REAL_BASE_IMAGE_CANDIDATES=docker.1ms.run/vllm/vllm-openai:v0.10.1.1,docker.m.daocloud.io/vllm/vllm-openai:v0.10.1.1,docker.m.daocloud.io/vllm/vllm-openai:v0.10.2,docker.io/vllm/vllm-openai:v0.10.1.1
MINERU_REAL_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
MINERU_REAL_SKIP_MODELS_DOWNLOAD=true
MINERU_REAL_PULL_TIMEOUT=600
MINERU_REAL_PULL_RETRIES=2
MINERU_REAL_AUTO_BUILD=false

PADDLEOCR_VL_API_URL=http://localhost:8802/parse
PADDLEOCR_VL_MODEL_DIR=/path/to/PaddleOCR-VL-0.9B
PADDLEOCR_LAYOUT_MODEL_DIR=/path/to/PP-DocLayoutV2
PADDLEOCR_VL_GPU_ID=0
PADDLEOCR_VL_API_HOST=0.0.0.0
PADDLEOCR_VL_API_PORT=8802
PADDLEOCR_VL_WORKERS=1
PADDLEOCR_VL_BACKGROUND=true
PADDLEOCR_VL_AUTO_KILL_PORT=true
ENABLE_PADDLEOCR_VL=false

DEEPSEEK_OCR_API_URL=http://localhost:8705/v1/ocr/pdf
DEEPSEEK_OCR_MODEL_DIR=/path/to/DeepSeek-OCR
DEEPSEEK_OCR_GPU_ID=0
DEEPSEEK_OCR_API_HOST=0.0.0.0
DEEPSEEK_OCR_API_PORT=8705
DEEPSEEK_OCR_WORKERS=1
DEEPSEEK_OCR_BACKGROUND=true
DEEPSEEK_OCR_AUTO_KILL_PORT=true
DEEPSEEK_OCR_LOCAL_FILES_ONLY=true
ENABLE_DEEPSEEK_OCR=false

VLLM_SERVER_URL=http://localhost:30000

# ============ Mock MinerU（仅联调/合同测试） ============
ENABLE_MOCK_MINERU=false
MOCK_MINERU_HOST=0.0.0.0
MOCK_MINERU_PORT=10010
MOCK_MINERU_SAMPLE_OUTPUT=/root/Agent-Project-Collection/cases/3_RAG—OCR/Multimodal_RAG_OCR/backend/output/extraction_results/a6d62b6a-6361-4a75-b56c-d811ff5ccc1a/mineru_output.json

# ============ Milvus 向量数据库配置 ============
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============ Milvus API 服务配置 ============
MILVUS_API_HOST=0.0.0.0
MILVUS_API_PORT=8000
MILVUS_API_ENABLED=true

# ============ Chat 服务配置 ============
CHAT_SERVICE_PORT=8501
CHAT_SERVICE_HOST=0.0.0.0
